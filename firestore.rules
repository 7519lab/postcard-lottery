rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "你的email";
    }
    match /participants/{nick} {
      allow read: if true;
      allow create: if request.resource.data.name == nick
        && request.resource.data.name.size() <= 20
        && request.resource.data.group in ['ld','irl']
        && request.resource.data.keys().hasOnly(['name','group','no','blessIdx','titleIdx','createdAt']);
      allow update, delete: if isAdmin();
    }
    match /config/counter {
      allow read: if true;
      allow update: if request.resource.data.count == resource.data.count + 1 || isAdmin();
      allow create: if isAdmin();
    }
    match /{coll}/{doc} {
      allow read: if coll in ['blessings','titles','postcards','locations','config'];
      allow write: if isAdmin();
    }
    match /private/{doc=**} {
      allow read, write: if isAdmin();
    }
  }
}
